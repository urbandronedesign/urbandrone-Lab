// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Project {
  id          String   @id @default(cuid())
  title       String
  year        Int
  category    String
  description String   @default("") // markdown
  credits     String   @default("")
  coverId     String?
  cover       Image?   @relation("ProjectCover", fields: [coverId], references: [id], onDelete: SetNull)
  images      Image[]  @relation("ProjectImages")
  // Tezos: "manual" (uploads and/or hand-picked tokens) or "contract"
  // (auto-created from a collection contract you own; membership is
  // maintained by the sync, texts and order are yours).
  source       String         @default("manual")
  // Where it lives on the site: "artworks" (gallery) or "lab" (experiments, research, tools)
  section      String         @default("artworks")
  slug         String?        @unique
  featured     Boolean        @default(false) // shown on the home page
  featuredOrder Int           @default(0) // position among the featured projects
  tags         String         @default("") // comma-separated
  linksJson    String         @default("[]") // external links [{ label, url }]
  contract     String?        @unique
  coverTokenId String?
  coverToken   Token?         @relation("ProjectCoverToken", fields: [coverTokenId], references: [id], onDelete: SetNull)
  tokens       ProjectToken[]
  order       Int      @default(0)
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([order])
  @@index([published])
}

// A Tezos NFT you minted, as indexed by objkt.com. Chain data is refreshed by
// the sync; `hidden` and the local media variants are ours.
model Token {
  id             String    @id // "<contract>:<tokenId>"
  pk             Int       @unique // objkt row id, used as the pagination cursor
  contract       String
  tokenId        String
  creator        String
  name           String    @default("")
  description    String    @default("")
  mime           String    @default("")
  artifactUri    String    @default("")
  displayUri     String    @default("")
  thumbnailUri   String    @default("")
  width          Int?
  height         Int?
  supply         Int       @default(1)
  tags           String    @default("") // comma-separated
  collectionName String    @default("")
  collectionPath String    @default("") // objkt.com/collections/<path>
  mintedAt       DateTime?
  // Local optimized variants live at public/media/<mediaKey>-<width>.webp
  mediaKey       String?
  mediaWidths    String    @default("") // e.g. "400,800,1600"
  placeholder    String?   // tiny base64 data URL for the blur-up
  hidden         Boolean   @default(false)
  syncedAt       DateTime  @updatedAt
  projects       ProjectToken[]
  coverFor       Project[] @relation("ProjectCoverToken")

  @@index([contract])
  @@index([creator])
}

model ProjectToken {
  projectId String
  tokenId   String
  order     Int     @default(0)
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  token     Token   @relation(fields: [tokenId], references: [id], onDelete: Cascade)

  @@id([projectId, tokenId])
  @@index([projectId, order])
}

// Small key/value store (sync cursors etc.)
model Setting {
  key   String @id
  value String
}

model Image {
  id        String    @id @default(cuid())
  url       String
  width     Int?
  height    Int?
  alt       String    @default("")
  projectId String?
  project   Project?  @relation("ProjectImages", fields: [projectId], references: [id], onDelete: Cascade)
  coverFor  Project[] @relation("ProjectCover")
  bioFor    Bio[]     @relation("BioPortrait")
  createdAt DateTime  @default(now())

  @@index([projectId])
}

// Admin sign-in. A single account is expected, but nothing prevents more.
model AdminUser {
  id           String          @id @default(cuid())
  username     String          @unique
  email        String          @unique
  passwordHash String
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  resets       PasswordReset[]
}

// Single-use, time-limited password reset links (only the hash is stored).
model PasswordReset {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// Site-wide information edited in the admin (single row, id = "site").
model Site {
  id          String   @id @default("site")
  name        String   @default("Atelier")
  tagline     String   @default("A Project Gallery")
  description String   @default("")
  author      String   @default("")
  copyright   String   @default("") // footer holder; falls back to name
  email       String   @default("")
  url         String   @default("")
  keywords    String   @default("") // comma-separated
  linksJson   String   @default("[]") // [{ label, url }]
  about       String   @default("") // statement shown on the home page (paragraphs)
  goatcounterCode String @default("") // GoatCounter site code (<code>.goatcounter.com); empty = no analytics
  updatedAt   DateTime @updatedAt
}

// Biography page (single row, id = "bio"): portrait, headline, text and a
// CV-style list stored as JSON [{ group, year, text, url }].
model Bio {
  id         String   @id @default("bio")
  headline   String   @default("")
  text       String   @default("")
  // Optional French version (the page shows an EN / FR switch when present)
  headlineFr String   @default("")
  textFr     String   @default("")
  portraitId String?
  portrait   Image?   @relation("BioPortrait", fields: [portraitId], references: [id], onDelete: SetNull)
  cvJson     String   @default("[]")
  updatedAt  DateTime @updatedAt
}

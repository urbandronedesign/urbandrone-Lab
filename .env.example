DATABASE_URL=file:../db/custom.db

# Admin sign-in (/admin). Change these before deploying.
ADMIN_USER=admin
ADMIN_PASSWORD=change-me

# Signs the admin session cookie. Any random string of 32+ characters,
# e.g.  node -p "require('crypto').randomBytes(32).toString('hex')"
AUTH_SECRET=

# Tezos wallets whose created NFTs are synced into the gallery (comma-separated)
TEZOS_WALLETS=tz1...

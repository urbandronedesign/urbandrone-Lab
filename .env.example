DATABASE_URL=file:../db/custom.db

# Signs the admin session cookie. Any random string of 32+ characters,
# e.g.  node -p "require('crypto').randomBytes(32).toString('hex')"
AUTH_SECRET=

# Tezos wallets whose created NFTs are synced into the gallery (comma-separated)
TEZOS_WALLETS=tz1...

# Outgoing mail for password-reset links (any SMTP server). Leave empty and the
# link is printed in the dev-server terminal instead.
# Gmail: SMTP_HOST=smtp.gmail.com  SMTP_PORT=587  SMTP_USER=you@gmail.com  SMTP_PASS=<16-char app password>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Google Analytics reporting for the admin dashboard (optional)
# GA_PROPERTY_ID is the numeric property id (GA -> Admin -> Property details), not the G- measurement id.
GA_PROPERTY_ID=
GOOGLE_APPLICATION_CREDENTIALS=./ga-credentials.json
